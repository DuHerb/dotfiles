brew "pnpm"                  # Fast, disk space efficient package manager
brew "yarn"                  # JavaScript package manager
brew "oven-sh/bun/bun"       # Incredibly fast JavaScript runtime, bundler, transpiler and package manager
brew "uv"                    # Extremely fast Python package installer and resolver, written in Rust
brew "openjdk@21"            # Development kit for the Java programming language

# Mobile development
brew "cocoapods"             # Dependency manager for Cocoa projects
brew "watchman"              # Watch files and take action when they change

# Databases
