// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "indent_guides": {
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "colorize_brackets": true,
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "terminal": {
    "dock": "bottom",
    "cursor_shape": "underline",
    "blinking": "on"
  },
  "icon_theme": "Catppuccin Macchiato",
  "features": {
    "edit_prediction_provider": "zed"
  },
  "agent": {
    "default_profile": "write",
    "dock": "right",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    },
  },
  "project_panel": {
    "dock": "right"
  },
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    // "dark": "One Dark"
    // "dark": "Tokyo Night Storm"
    "dark": "Catppuccin Macchiato"
  },
  "experimental.theme_overrides": {
    "editor.active_line_number": "#ff9e64"
  },
  "vim_mode": false,
  "relative_line_numbers": "disabled",
  "telemetry": {
    "metrics": false
  },
  "tab_bar": {
    "show": false
  },
  "ui_font_size": 15,
  "buffer_font_size": 15,
  "line_numbers": true,
  "buffer_font_family": "CaskaydiaMono Nerd Font",
  "autosave": { "after_delay": { "milliseconds": 1000 } }, 
  "scrollbar": {
    "show": "never"
  },
  "preview_tabs": {
    // Whether preview tabs should be enabled.
    // Preview tabs allow you to open files in preview mode, where they close automatically
    // when you switch to another file unless you explicitly pin them.
    // This is useful for quickly viewing files without cluttering your workspace.
    "enabled": true,
    // Whether to open tabs in preview mode when selected from the file finder.
    "enable_preview_from_file_finder": false,
    // Whether a preview tab gets replaced when code navigation is used to navigate away from the tab.
    "enable_keep_preview_on_code_navigation": false
  },
  "show_whitespaces": "boundary"
}
